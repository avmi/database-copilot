{
  "name": "mcp-database-copilot",
  "version": "2.0.0",
  "description": "MCP Server - Database Schema & Query Copilot for VS Code (Multi-DB)",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "mcp-database-copilot": "src/index.js"
  },
  "files": [
    "src",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:stdio": "node src/index.js --transport stdio",
    "dev": "node --watch src/index.js",
    "dev:stdio": "node --watch src/index.js --transport stdio",
    "test:setup": "node scripts/setup-test-db.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:e2e": "node scripts/e2e-mcp-client.js",
    "test": "npm run test:setup && npm run test:smoke"
  },
  "keywords": [
    "mcp",
    "database",
    "copilot",
    "vscode",
    "postgresql",
    "mysql",
    "mariadb",
    "mongodb",
    "sqlserver",
    "sqlite",
    "csv",
    "schema"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mariadb": "^3.4.0",
    "mongodb": "^6.12.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
